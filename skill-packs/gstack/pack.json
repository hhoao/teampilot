{
  "id": "garrytan/gstack",
  "name": "gstack",
  "repoOwner": "garrytan",
  "repoName": "gstack",
  "repoBranch": "main",
  "recipe": {
    "steps": [
      {
        "id": "sync",
        "uses": "git.sync",
        "with": {
          "owner": "garrytan",
          "name": "gstack",
          "branch": "main"
        }
      },
      {
        "id": "skills",
        "uses": "skill.register-pack",
        "needs": [
          "sync"
        ]
      },
      {
        "id": "bins",
        "uses": "fs.materialize",
        "needs": [
          "sync"
        ],
        "with": {
          "from": "bin",
          "to": "$PACK_BIN",
          "mode": "link"
        }
      },
      {
        "id": "setup",
        "uses": "script.run",
        "needs": [
          "bins"
        ],
        "with": {
          "cwd": "$SYNC_ROOT",
          "command": [
            "./setup"
          ]
        },
        "optional": true
      }
    ],
    "exports": {
      "path": [
        "$PACK_BIN"
      ],
      "skills": [
        "garrytan/gstack:office-hours",
        "garrytan/gstack:plan-ceo-review",
        "garrytan/gstack:plan-eng-review",
        "garrytan/gstack:plan-design-review",
        "garrytan/gstack:review",
        "garrytan/gstack:investigate",
        "garrytan/gstack:qa",
        "garrytan/gstack:cso",
        "garrytan/gstack:ship"
      ]
    }
  },
  "skills": [
    {
      "id": "garrytan/gstack:office-hours",
      "directory": "office-hours",
      "name": "Office Hours"
    },
    {
      "id": "garrytan/gstack:plan-ceo-review",
      "directory": "plan-ceo-review",
      "name": "CEO Review"
    },
    {
      "id": "garrytan/gstack:plan-eng-review",
      "directory": "plan-eng-review",
      "name": "Eng Manager Review"
    },
    {
      "id": "garrytan/gstack:plan-design-review",
      "directory": "plan-design-review",
      "name": "Design Review"
    },
    {
      "id": "garrytan/gstack:review",
      "directory": "review",
      "name": "Staff Review"
    },
    {
      "id": "garrytan/gstack:investigate",
      "directory": "investigate",
      "name": "Investigate"
    },
    {
      "id": "garrytan/gstack:qa",
      "directory": "qa",
      "name": "QA"
    },
    {
      "id": "garrytan/gstack:cso",
      "directory": "cso",
